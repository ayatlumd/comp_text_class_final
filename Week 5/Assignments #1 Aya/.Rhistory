library(tidyverse)
library(janitor)
library(dplyr)
library(ggplot2)
Black_index <- rio::import("https://raw.githubusercontent.com/wellsdata/CompText_Jour/main/data/blackindex_master.csv") %>%
clean_names()
print(paste0("This dataset has ", nrow(Black_index), " rows and ", ncol(Black_index), " columns. Each row in this dataset appears to describe a single article that appeared in newspaper between ", min(Black_index$year), " and ", max(Black_index$year), ". The articles appear to have been sourced from several historical newspaper databases and archives."))
Black_index %>%
count(newspaper_city) %>%
slice_max(order_by = n, n = 20)
#For just 15 entries:
#slice_max(order_by = n, n = 15, with_ties = F)
Black_index %>%
count(newspaper_city) %>%
slice_max(order_by = n, n = 20, with_ties = F)
#For just 15 entries:
#slice_max(order_by = n, n = 15, with_ties = F)
Black_index %>%
count(newspaper_city) %>%
slice_max(order_by = n, n = 20, with_ties = F)
filter(!is.na(newspaper_city))
View(Black_index)
Black_index %>%
count(newspaper_city) %>%
slice_max(order_by = n, n = 20, with_ties = F)
drop_na()
Black_index %>%
count(newspaper_city) %>%
slice_max(order_by = n, n = 20, with_ties = F)
drop_na(newspaper_city)
Black_index %>%
count(newspaper_city) %>%
slice_max(order_by = n, n = 20, with_ties = F)
names(Black_index)
Black_index %>%
count(newspaper_city) %>%
slice_max(order_by = n, n = 20, with_ties = F)
newspaper_city <- Black_index %>%
filter(!is.na(newspaper_city)) %>%
count(newspaper_city, sort = TRUE) %>%
slice_head(n = 20)
newspaper_city
year_count <- Black_index %>%
count(year) %>%
arrange(year)
year_count
Black_index |>
distinct(file_name, .keep_all = TRUE) |>
count(year) |>
arrange(desc(n))
year_count <- Black_index %>%
count(year) %>%
arrange(year)
year_count
Black_index %>%
count(year) %>%
arrange(desc(n)) %>%
ggplot(aes(x = year, y = n,
fill = n)) +
geom_col(position = "dodge") +
theme(legend.position = "none") +
labs(
title = "Total Newspaper Entries by Year",
y = "Number of Entries",
x = "Year",
caption = "Graphic by Aya, October 1, 2026"
)
library(tidyverse)
library(janitor)
library(dplyr)
library(ggplot2)
Black_index <- rio::import("https://raw.githubusercontent.com/wellsdata/CompText_Jour/main/data/blackindex_master.csv") %>%
clean_names()
print(paste0("This dataset has ", nrow(Black_index), " rows and ", ncol(Black_index), " columns. Each row in this dataset appears to describe a single article that appeared in newspaper between ", min(Black_index$year), " and ", max(Black_index$year), ". The articles appear to have been sourced from several historical newspaper databases and archives."))
Black_index %>%
count(newspaper_city) %>%
slice_max(order_by = n, n = 20, with_ties = F)
newspaper_city <- Black_index %>%
filter(!is.na(newspaper_city)) %>%
count(newspaper_city, sort = TRUE) %>%
slice_head(n = 20)
newspaper_city
Black_index |>
distinct(file_name, .keep_all = TRUE) |>
count(year) |>
arrange(desc(n))
year_count <- Black_index %>%
count(year) %>%
arrange(year)
year_count
Black_index %>%
count(year) %>%
arrange(desc(n)) %>%
ggplot(aes(x = year, y = n,
fill = n)) +
geom_col(position = "dodge") +
theme(legend.position = "none") +
labs(
title = "Total Newspaper Entries by Year",
y = "Number of Entries",
x = "Year",
caption = "Graphic by Aya, October 1, 2026"
)
View(Black_index)
View(newspaper_city)
View(year_count)
View(Black_index)
View(Black_index)
