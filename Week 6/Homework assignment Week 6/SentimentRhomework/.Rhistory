articles_df <- read_csv("articles_df.csv")
articles <- articles_df %>%
filter(!is.na(sentence),
# drop metadata lines (copyright, length, byline, etc.)
!str_detect(sentence, "^(Copyright|Length:|Byline:|Load-Date:|Section:)")) %>%
group_by(filename) %>%
summarize(title          = first(title),
published_date = first(published_date),
publication    = first(publication_4),
text           = paste(sentence, collapse = " "),
.groups = "drop") %>%
mutate(published_date = as.Date(published_date),
year = year(published_date),
id   = row_number())
nrow(articles)   # should be 78
stats <- function(df, col = ave_sentiment) {
df %>%
summarize(n      = n(),
min    = min({{ col }},    na.rm = TRUE),
max    = max({{ col }},    na.rm = TRUE),
median = median({{ col }}, na.rm = TRUE),
sd     = sd({{ col }},     na.rm = TRUE))
}
