library(lexicon)
cliche_list <- str_to_lower(cliches)
all_text <- str_to_lower(paste(articles$text, collapse = " "))
# Which cliches appear in my articles, and how often?
cliches_found <- tibble(cliche = cliche_list) |>
mutate(times = str_count(all_text, fixed(cliche))) |>
filter(times > 0) |>
arrange(desc(times))
cliches_found
library(lexicon)
Action_verbs_list <- str_to_lower(pos_action_verb)
all_text <- str_to_lower(paste(articles$text, collapse = " "))
# Which action verbs appear in my articles, and how often?
Action_verbs_found <- tibble(pos_action_verb = Action_verbs_list) |>
mutate(times = str_count(all_text, fixed(pos_action_verb))) |>
filter(times > 0) |>
arrange(desc(times))
Action_verbs_found
library(lexicon)
emotion_list <- str_to_lower(emotion)
library(lexicon)
# Split my articles into individual lowercase words and count them
word_counts <- tibble(token = str_extract_all(str_to_lower(paste(articles$text, collapse = " ")), "[a-z']+")[[1]]) |>
count(token, sort = TRUE)
# Keep only the words that are in the emotion lexicon
emotion_found <- word_counts |>
inner_join(hash_nrc_emotions, by = "token")
head(emotion_found)
