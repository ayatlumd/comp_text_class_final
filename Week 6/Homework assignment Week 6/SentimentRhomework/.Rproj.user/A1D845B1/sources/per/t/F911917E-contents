#Loading libraries, packages are pre-installed. 

```{r}
library(tidyverse)
library(sentimentr)
library(lubridate)
library(magrittr)
```

# In the provided template during the class my file would not work. So, to adapt the first code, I used AI to consult. It told me that my file has one row per line of text, so I needed to put each article's lines back together into one row per article.

```{r}
articles_df <- read_csv("articles_df.csv")
articles <- articles_df |> 
  filter(!is.na(sentence)) |> 
  group_by(filename) |> 
  summarize(published_date = first(published_date),
            text = paste(sentence, collapse = " ")) |> 
  mutate(year = year(as.Date(published_date))) |> 
  mutate(id = row_number()) |> 
  select(id, year, text)

nrow(articles)   # number of articles = 78
head(articles)
```


# Part 1: Sentiment analysis for all 78 articles

```{r}
articles_sentiment <- articles |> 
  select(id, text) |> 
  get_sentences() |> 
  sentiment_by(by = c("id"))

# As per AI suggestion, I needed to add the scores back to my articles, so it advised me this code to do that. 

articles <- articles |> 
  left_join(as_tibble(articles_sentiment) |> select(id, ave_sentiment), by = "id")
```
#The minimum sentiment score is -0.3171013, the maximum is 0.7591947, the median is -0.08552358, standard deviation is 0.1922006

```{r}
articles |> 
  summarize(min = min(ave_sentiment),
            max = max(ave_sentiment),
            median = median(ave_sentiment),
            sd = sd(ave_sentiment))
```
