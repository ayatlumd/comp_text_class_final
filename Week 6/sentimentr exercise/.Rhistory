install.packages("lexicon")
library(lexicon)
cliches <- cliches
head(cliches)
jockers <- hash_sentiment_jockers
View(jockers)
#trump <- read_tsv("trump_dallas_sept_9_2026.txt")
trump <- read.table("trump_dallas_sept_9_2026.txt", header = F, sep = "\t") |>
rename(text = V1) |>
mutate(text = str_replace(text, "Trump:", "")) |>
mutate(id = row_number())
View(trump)
trump_sentiment <- trump %>%
get_sentences() %>%
sentiment_by(by = c("id"))
View(trump_sentiment)
trump_sentiment <- trump %>%
get_sentences() %>%
sentiment_by(by = c("id"))
print(paste0("From this exercise, the most positive sentence in Trump's speech was scored at ", max(trump_sentiment$ave_sentiment), "while the most negative was scored at", min(trump_sentiment$ave_sentiment),". For context, the median value was ", median(trump_sentiment$ave_sentiment), "."))
